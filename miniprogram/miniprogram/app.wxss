@import "generated/appearance.wxss";
page { background:var(--page); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,sans-serif; font-size:28rpx; }
view,input,button,textarea { box-sizing:border-box; }
button::after { border:0; }
.theme-page { min-height:100vh; background:var(--page); color:var(--ink); }
input,textarea { color:var(--ink); }
.theme-placeholder,.muted { color:var(--muted); }
.error { color:var(--danger); line-height:1.6; }
.primary { background:var(--accent); color:var(--on-accent); font-size:28rpx; border-radius:16rpx; }
.match-0 { background:var(--highlight); color:var(--highlight-ink); }
.match-1 { background:var(--highlight-1); color:var(--highlight-ink); }
.match-2 { background:var(--highlight-2); color:var(--highlight-ink); }
.match-3 { background:var(--highlight-3); color:var(--highlight-ink); }
.match-4 { background:var(--highlight-4); color:var(--highlight-ink); }
.match-5 { background:var(--highlight-5); color:var(--highlight-ink); }
.match-6 { background:var(--highlight-6); color:var(--highlight-ink); }
.match-7 { background:var(--highlight-7); color:var(--highlight-ink); }
.match-8 { background:var(--highlight-8); color:var(--highlight-ink); }
.match-9 { background:var(--highlight-9); color:var(--highlight-ink); }
.match-10 { background:var(--highlight-10); color:var(--highlight-ink); }
.match-11 { background:var(--highlight-11); color:var(--highlight-ink); }
