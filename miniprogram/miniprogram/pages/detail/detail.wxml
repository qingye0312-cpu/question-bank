<view class="theme-page detail" style="{{themeStyle}}">
  <view wx:if="{{loading}}" class="muted">正在读取题目…</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view wx:if="{{layer}}" class="detail-meta">{{layer}}</view><view class="detail-meta muted">{{kind}} · {{number}}</view>
    <view class="paper">
      <view class="stem {{kind === '编程' ? 'programming-stem' : ''}}"><text user-select wx:for="{{stem}}" wx:key="index" class="{{item.color >= 0 ? 'match-' + item.color : ''}}">{{item.text}}</text></view>
      <view wx:for="{{options}}" wx:key="key" class="option {{item.correct ? 'correct-option' : ''}}">
        <text class="option-key">{{item.key}}.</text>
        <view class="option-body"><text user-select wx:for="{{item.segments}}" wx:for-item="part" wx:for-index="partIndex" wx:key="partIndex" class="{{part.color >= 0 ? 'match-' + part.color : ''}}">{{part.text}}</text></view>
      </view>
    </view>
    <view class="answer-card"><view class="muted label">答案</view><view class="answer">{{answer}}</view></view>
    <view wx:if="{{explanation}}" class="paper explanation"><view class="muted label">解析</view><text user-select>{{explanation}}</text></view>
    <view class="metadata muted"><view wx:for="{{metadata}}" wx:key="label"><text>{{item.label}}：</text><text user-select wx:for="{{item.segments}}" wx:for-item="part" wx:for-index="partIndex" wx:key="partIndex" class="{{part.color >= 0 ? 'match-' + part.color : ''}}">{{part.text}}</text></view></view>
  </block>
</view>
