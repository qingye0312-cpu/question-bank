.detail { padding: 28rpx 26rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.detail-meta { margin: 0 8rpx 24rpx; font-size: 24rpx; }
.paper { background:var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx; padding: 28rpx; }
.stem { font-size: 32rpx; line-height: 1.85; white-space: pre-wrap; word-break: break-all; }
.programming-stem { background:var(--surface-soft); border:1rpx solid var(--line); border-radius:12rpx; padding:22rpx; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:27rpx; line-height:1.7; }
.option { margin-top: 24rpx; padding: 20rpx; border-radius: 12rpx; display: flex; background: var(--surface-soft); line-height: 1.8; }
.correct-option { background: var(--correct-bg); }
.option-key { flex: none; width: 44rpx; font-weight: 600; }
.option-body { flex: 1; min-width: 0; white-space: pre-wrap; word-break: break-all; }
.answer-card { background: var(--correct-bg); border-radius: 20rpx; padding: 28rpx; margin-top: 24rpx; }
.label { font-size: 24rpx; margin-bottom: 12rpx; }
.answer { color: var(--correct); font-size: 38rpx; font-weight: 600; }
.explanation { margin-top: 24rpx; font-size:26rpx; line-height: 1.7; word-break: break-all; }
.explanation>text { white-space:pre-wrap; }
.review-status { display:inline-block; margin-left:12rpx; padding:2rpx 8rpx; border-radius:6rpx; background:var(--warning-bg); color:var(--warning); font-size:23rpx; }
.source-toggle { margin:20rpx 0 0; padding:8rpx 0; border:0; background:transparent; text-align:left; font-size:24rpx; line-height:1.7; color:var(--secondary); }
.source-toggle::after { border:0; }
.source-toggle>text { margin-left:12rpx; }
.answer-sources { font-size:24rpx; color:var(--secondary); }
.answer-sources>text { display:block; margin-top:16rpx; padding:20rpx; background:var(--surface-soft); border-radius:8rpx; white-space:pre-wrap; }
.metadata { padding: 28rpx 8rpx; font-size: 23rpx; line-height: 1.9; word-break: break-all; }

.correct-option .option-key{color:var(--correct)}
