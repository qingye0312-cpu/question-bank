.page{padding:28rpx;background:#f6f8f6;color:#233c31}.title{font-size:36rpx;font-weight:700;margin:16rpx 0}.hint{font-size:24rpx;color:#697c71;margin:14rpx 0;word-break:break-all}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin:16rpx 0}.actions button{flex:1;margin:0;font-size:28rpx}.picker{padding:24rpx;background:#fff;border-radius:12rpx;margin:16rpx 0}.editor,.section{background:white;padding:24rpx;border-radius:18rpx;margin:24rpx 0}.label{font-weight:600;margin:22rpx 0 12rpx}textarea,input{box-sizing:border-box;width:100%;background:#f4f7f4;border:1rpx solid #dce5de;border-radius:10rpx;padding:18rpx;font-size:30rpx;min-height:80rpx;margin:12rpx 0}textarea{line-height:1.65}.option{display:flex;align-items:flex-start;padding:16rpx 8rpx;border:2rpx solid #dce5de;border-radius:14rpx;margin:16rpx 0}.option-content{flex:1;min-width:0}.option .dot{margin:0;padding:4rpx;min-width:64rpx;width:64rpx;background:transparent;font-size:44rpx;line-height:1.6;color:#64816d}.dot::after{border:0}.selected{background:#e5f4e9!important;border-color:#29854c!important;color:#177b3b}.selected .dot{color:#177b3b}.entry{padding:20rpx 0;border-bottom:1rpx solid #dce5de}.error{color:#ac3131;padding:18rpx;background:#fff0f0}.notice{color:#216a42;padding:18rpx;background:#eaf6ef}button[type=primary]{background:#28654a;margin-top:20rpx}.judgment button{border:2rpx solid #dce5de}

.upload-all{width:100%!important;max-width:none;box-sizing:border-box;font-size:30rpx;white-space:nowrap}
