.intake-page{padding:28rpx 32rpx 72rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom));}
.intake-page .primary[disabled]{background:#d7e5db;color:#375945;opacity:1}
.cloud-card,.receipt{margin:20rpx 0;padding:24rpx;border-radius:16rpx;background:#e7eeea;border:1rpx solid #c8d8cd}.receipt text{display:block;overflow-wrap:anywhere;font-size:22rpx;line-height:1.7}.cloud-card button{margin-bottom:0}
.heading{font-size:38rpx;font-weight:650;display:flex;justify-content:space-between;align-items:baseline;margin-bottom:24rpx}.heading text{font-size:22rpx;font-weight:400}
button{font-size:25rpx;border-radius:14rpx;margin:18rpx 0;line-height:1.6;padding:18rpx;background:#e7eeea;color:#285a42}button[disabled]{opacity:.5}
.prompt-card{text-align:left;display:flex;flex-wrap:wrap;justify-content:space-between;background:white;border:1rpx solid #c8d8cd;gap:12rpx}.prompt-card text{color:#246b4b;font-weight:600}
.hint{font-size:23rpx;line-height:1.7;margin:14rpx 0;overflow-wrap:anywhere}.bank-tools{display:flex;align-items:center;gap:12rpx}.bank-tools picker{flex:1;min-width:0}.bank-tools button{flex:none;font-size:23rpx}
.select{border:1rpx solid #c8d8cd;border-radius:14rpx;background:white;padding:22rpx;font-size:25rpx;overflow-wrap:anywhere}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;font-weight:600}.section-heading button{font-weight:400;font-size:23rpx;padding:12rpx 18rpx}
.reply-input{box-sizing:border-box;width:100%;min-height:220rpx;max-height:580rpx;border:1rpx solid #c8d8cd;border-radius:14rpx;background:white;padding:22rpx;font-size:25rpx;line-height:1.7}
.preview,.entry{background:white;border:1rpx solid #dce7df;border-radius:16rpx;padding:24rpx;margin:20rpx 0}.preview-title{font-weight:600;color:#246b4b;margin-bottom:18rpx}.full-text{display:block;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8}.option{margin:12rpx 0;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}.answer{font-weight:600;color:#246b4b;margin:20rpx 0}.entry button{margin-bottom:0}.share{background:#d9eddf;color:#1d5938;font-weight:600}.notice{background:#e5eee7;padding:20rpx;border-radius:12rpx;line-height:1.8;overflow-wrap:anywhere}.error{margin:20rpx 0;overflow-wrap:anywhere}.primary{background:#246b4b;color:white}

.field-label{font-size:24rpx;margin:20rpx 0 10rpx}.edit-field{box-sizing:border-box;width:100%;min-height:72rpx;margin:10rpx 0;padding:16rpx;border:1rpx solid #b5cbbd;border-radius:10rpx;line-height:1.6;background:#f8fbf9}.option-tools{display:flex;gap:12rpx}.option-tools button{flex:1;font-size:22rpx;padding:8rpx;margin:8rpx 0}
