page{background:var(--page);color:var(--ink);font-size:30rpx}
.intake-page{padding:32rpx 28rpx calc(210rpx + env(safe-area-inset-bottom))}
.title{font-size:42rpx;font-weight:650}
.muted{font-size:25rpx;color:var(--muted);line-height:1.65}
.header .muted{margin-top:8rpx}
.bank-picker{padding:24rpx 0;display:flex;justify-content:space-between}
.tabs{display:flex;border-bottom:2rpx solid var(--border);margin-bottom:28rpx}
.tabs button{flex:1;background:transparent;border-radius:0;color:var(--muted);font-size:29rpx;padding:14rpx 0;margin:0;border-bottom:5rpx solid transparent}
.tabs button.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
button::after{border:0}
button{font-size:28rpx;border-radius:16rpx;background:var(--tint);color:var(--accent);line-height:1.5;padding:20rpx 24rpx}
button[disabled]{opacity:.45}
button[type=primary]{background:var(--accent);color:var(--on-accent)}
.tools{display:flex;gap:18rpx;margin-bottom:32rpx}
.tools button{flex:1}
.accent-soft{background:var(--selected)}
.label{font-weight:600;margin:30rpx 0 14rpx}
.question-meta{display:flex;gap:20rpx;align-items:center;justify-content:space-between}
.type-picker{padding:14rpx 24rpx;border-radius:14rpx;background:var(--tint)}
.time{margin-top:18rpx}
input,textarea{box-sizing:border-box;background:var(--surface);border:2rpx solid var(--border);border-radius:16rpx;padding:24rpx;width:100%;line-height:1.7;font-size:30rpx;min-height:88rpx}
textarea{min-height:100rpx}
.option{display:flex;align-items:center;background:var(--surface);border:2rpx solid var(--border);border-radius:18rpx;padding:16rpx 8rpx;margin-top:14rpx}
.selected{border-color:var(--correct-border)!important;background:var(--correct-bg)!important}
.option button.dot{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;width:64rpx;min-width:0;max-width:64rpx;height:72rpx;margin:0;padding:0;background:transparent;line-height:1;color:var(--muted)}
.answer-indicator{width:30rpx;height:30rpx;border:3rpx solid var(--muted);border-radius:50%;background:transparent}
.selected .answer-indicator{background:var(--correct);border-color:var(--correct)}
.option-body{flex:1;width:0;min-width:0;margin:0 8rpx 0 12rpx}
.option-key{flex:0 0 28rpx;width:28rpx;font-weight:600;font-size:27rpx;text-align:center}
.option textarea{display:block;width:100%;min-height:51rpx;margin:0;border:0;padding:0;background:transparent;border-radius:0;line-height:1.7;word-break:break-word;overflow-wrap:anywhere}
.option button.option-menu{display:flex;align-items:center;justify-content:center;flex:0 0 56rpx;width:56rpx;min-width:0;max-width:56rpx;height:72rpx;margin:0;padding:0;font-size:26rpx;line-height:1;background:transparent}
.judgment{display:flex;gap:20rpx;margin-top:18rpx}
.judgment button{flex:1;border:2rpx solid var(--border)}
.editor button.add-option{margin:22rpx 0 0;background:transparent;width:100%;border:2rpx dashed var(--accent-border)}
.disclosure{background:transparent;text-align:left;padding:26rpx 0;margin:24rpx 0 0;width:100%;border-top:2rpx solid var(--line);color:var(--muted)}
.metadata input,.metadata textarea{margin-top:18rpx}
.empty{padding:90rpx 30rpx;text-align:center;display:flex;flex-direction:column;gap:26rpx;color:var(--muted)}
.empty-icon{font-size:70rpx;line-height:1}
.empty button{font-size:26rpx}
.issue{color:var(--danger);background:var(--danger-bg);border-radius:14rpx;padding:22rpx;margin:22rpx 0;font-size:26rpx;line-height:1.7}
.issue button{margin-top:12rpx}
.notice{padding:20rpx 0;color:var(--accent)}
.record{padding:28rpx 0;border-bottom:2rpx solid var(--line);display:flex;align-items:center;gap:24rpx}
.record>view{flex:1;min-width:0}
.record-title{font-size:30rpx;line-height:1.65;margin-bottom:10rpx}
.record button{flex-shrink:0;font-size:24rpx;padding:12rpx 20rpx;margin:0}
.warning{color:var(--warning);font-size:25rpx;line-height:1.7}
.file-tools{display:flex;flex-direction:column;gap:18rpx}
.maintainer-apply{margin-top:36rpx;padding:24rpx;border:2rpx solid var(--border);border-radius:18rpx;background:var(--surface-soft)}
.maintainer-apply input{margin-top:16rpx}.maintainer-apply button{width:100%;margin-top:16rpx}
.file-tools button{width:100%;font-size:27rpx}
.footer{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:2rpx solid var(--border);padding:16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));z-index:10}
.save-status{font-size:24rpx;color:var(--muted);margin-bottom:12rpx}
.footer-actions{display:flex;gap:18rpx}
.footer-actions button{margin:0;flex:1}
.footer-actions button[type=primary]{flex:1.6}

.record>.record-actions{flex:0 0 auto;display:flex;flex-direction:column;gap:14rpx}
.record-actions .record-delete{color:var(--danger);background:var(--danger-bg)}

.selected .dot,.judgment .selected{color:var(--correct)}

.maintainer-apply .identity-label{margin-top:24rpx}.maintainer-apply .identity-input{box-sizing:border-box;width:100%;min-height:128rpx;margin-top:12rpx}.identity-count{text-align:right;margin-top:8rpx}
