<view class="page">
 <view class="title">连续录题</view><view class="hint">先录完多道题，再统一确认上传</view>
 <picker range="{{banks}}" range-key="display_name" value="{{bankIndex}}" bindchange="onBankChange" disabled="{{busy}}"><view class="picker">题库：{{banks[bankIndex].display_name}} ▾</view></picker>
 <view class="actions"><button bindtap="onCopyPrompt" disabled="{{busy}}">复制提示词</button><button type="primary" bindtap="onPaste" disabled="{{busy}}">粘贴题目</button></view>
 <view class="actions"><button size="mini" bindtap="onManual" disabled="{{busy}}">手工录题</button><button wx:if="{{hasPrevious}}" size="mini" bindtap="onRestore" disabled="{{busy}}">恢复上份草稿</button></view>
 <view wx:if="{{reply}}" class="editor">
  <picker range="{{types}}" value="{{typeIndex}}" bindchange="onType" disabled="{{busy}}"><view class="picker">题型：{{types[typeIndex]}} ▾</view></picker>
  <view class="hint">录入时间：{{editing ? recordedAt : '首次保存本题时记录'}}</view>
  <view class="label">题目</view><textarea value="{{reply.stem}}" data-field="stem" bindinput="onField" auto-height maxlength="-1" disabled="{{busy}}"/>
  <view wx:if="{{reply.type !== 'true_false'}}">
   <view class="hint">点击圆点标记答案，再次点击取消</view>
   <view wx:for="{{editOptions}}" wx:key="key" class="option {{item.correct ? 'selected' : ''}}">
    <button class="dot" data-key="{{item.key}}" bindtap="onAnswer" disabled="{{busy}}" aria-label="{{item.key}} {{item.correct ? '已选为正确答案' : '未选'}}">{{item.correct ? '●' : '○'}}</button>
    <view class="option-content"><view>{{item.key}}</view><textarea value="{{item.content}}" data-field="option" data-index="{{index}}" bindinput="onField" auto-height maxlength="-1" disabled="{{busy}}"/>
     <view class="actions"><button size="mini" data-index="{{index}}" data-action="up" bindtap="onOption" disabled="{{busy || index === 0}}">上移</button><button size="mini" data-index="{{index}}" data-action="down" bindtap="onOption" disabled="{{busy || index === editOptions.length - 1}}">下移</button><button size="mini" data-index="{{index}}" data-action="remove" bindtap="onOption" disabled="{{busy || editOptions.length <= 2}}">删除</button></view>
    </view>
   </view><button size="mini" data-action="add" bindtap="onOption" disabled="{{busy || editOptions.length >= 8}}">添加选项</button>
  </view>
  <view wx:else class="actions judgment"><button class="{{boolSelected && reply.answer === true ? 'selected' : ''}}" data-value="true" bindtap="onBool" disabled="{{busy}}">{{boolSelected && reply.answer === true ? '●' : '○'}} 正确</button><button class="{{boolSelected && reply.answer === false ? 'selected' : ''}}" data-value="false" bindtap="onBool" disabled="{{busy}}">{{boolSelected && reply.answer === false ? '●' : '○'}} 错误</button></view>
  <view class="label">解析</view><textarea value="{{reply.explanation}}" data-field="explanation" bindinput="onField" auto-height maxlength="-1" disabled="{{busy}}"/>
  <view class="label">模型名称</view><input value="{{reply.model.name}}" data-field="name" bindinput="onField" disabled="{{busy}}"/><view class="label">模型版本</view><input value="{{reply.model.version}}" data-field="version" bindinput="onField" disabled="{{busy}}"/>
  <picker range="{{versionSources}}" value="{{sourceIndex}}" bindchange="onVersionSource" disabled="{{busy}}"><view class="picker">版本来源：{{versionSources[sourceIndex]}} ▾</view></picker>
  <view class="label">需核实的说明（每行一项）</view><textarea value="{{warningsText}}" data-field="warnings" bindinput="onField" auto-height maxlength="-1" disabled="{{busy}}"/>
  <view class="label">更多信息</view><input placeholder="章节" value="{{metadata.chapter}}" data-field="chapter" bindinput="onMetadata" disabled="{{busy}}"/><input placeholder="标签，用 | 分隔" value="{{tagsText}}" data-field="tags" bindinput="onMetadata" disabled="{{busy}}"/>
  <picker range="{{difficulties}}" value="{{difficultyIndex}}" bindchange="onDifficulty" disabled="{{busy}}"><view class="picker">难度：{{difficulties[difficultyIndex]}} ▾</view></picker>
  <input placeholder="适用版本" value="{{metadata.applicable_version}}" data-field="applicable_version" bindinput="onMetadata" disabled="{{busy}}"/><input placeholder="外部编号" value="{{metadata.external_id}}" data-field="external_id" bindinput="onMetadata" disabled="{{busy}}"/>
  <button type="primary" bindtap="onSave" disabled="{{busy}}">{{editing ? '保存修改' : '保存本题，继续下一题'}}</button><button bindtap="onClear" disabled="{{busy}}">收起草稿，查看整批</button>
 </view>
 <view wx:elif="{{text}}" class="hint">原文已保存在草稿中。识别失败可重新粘贴或手工录题。</view>
 <view class="hint">{{saved}}</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="notice" wx:if="{{notice}}">{{notice}}</view>
 <view class="section"><view class="title">待上传 · {{entries.length}} 题</view><view class="hint">当前题库未上传的新题统一放在这里，全部录完后统一上传。</view>
 <view wx:for="{{entries}}" wx:key="id" class="entry"><view>{{item.stem}}</view><view class="hint">答案：{{item.answer}} · 录入：{{item.recordedAt}}</view><view class="hint">{{item.statusLabel}}</view><button wx:if="{{item.editable}}" size="mini" bindtap="onEdit" data-id="{{item.id}}" disabled="{{busy}}">编辑本题</button></view>
 <button type="primary" bindtap="onUpload" class="upload-all" disabled="{{busy || uploadBlocked || !entries.length}}">这一批录完了，统一上传</button>
 <view wx:if="{{reviewRows.length && reviewBank === bankId}}" class="section"><view class="title">上传前核实全部 {{reviewRows.length}} 题</view><view wx:for="{{reviewRows}}" wx:key="id" class="entry"><view>{{index + 1}}. {{item.stem}}</view><view wx:for="{{item.options}}" wx:for-item="option" wx:key="key">{{option.key}}. {{option.content}}</view><view>正确答案：{{item.answer}}</view><view>解析：{{item.explanation}}</view><view class="hint">录入：{{item.recordedAt}}</view></view><button bindtap="onCancelReview" disabled="{{busy}}">返回修改</button><button type="primary" bindtap="onUpload" disabled="{{busy}}">已核实，确认上传这 {{reviewRows.length}} 题</button></view>
 <view wx:for="{{jobLabels}}" wx:key="*this" class="hint">{{item}}</view>
 </view>
 <view class="section"><view class="label">增量文件与历史记录</view><picker range="{{batches}}" range-key="label" value="{{batchIndex}}" bindchange="onBatchChange" disabled="{{busy}}"><view class="picker">导出记录：{{batches[batchIndex].label}} ▾</view></picker><view class="actions"><button bindtap="onExport" size="mini" disabled="{{busy || !batchId}}">导出所选增量文件</button><button wx:if="{{filePath}}" bindtap="onShare" size="mini" disabled="{{busy}}">转发给好友</button></view></view>
 <view class="section"><view class="label">开发者与文件工具</view><view class="hint">日常搜题、录题无需登录。仅获授权开发者可上传。</view><view class="actions"><button wx:if="{{!loggedIn}}" bindtap="onLogin" disabled="{{busy || !cloudConfigured}}">开发者登录</button><button wx:else bindtap="onLogout" disabled="{{busy}}">退出登录</button><button bindtap="onSyncReview" disabled="{{busy}}">更新云端状态</button></view><view class="hint">{{authorizedNames}}</view><view class="actions"><button bindtap="onCreateBank" size="mini" disabled="{{busy}}">新建题库</button><button bindtap="onImport" size="mini" disabled="{{busy}}">从聊天导入增量包</button></view></view>
</view>
