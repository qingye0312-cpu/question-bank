<view class="theme-page intake-page" style="{{themeStyle}}">
 <view class="header"><view class="title">录入新题</view><view class="muted">自动存本机 · 录完后一次上传</view></view>
 <view class="bank-select-row"><picker class="bank-picker-control" range="{{banks}}" range-key="name" value="{{bankIndex}}" bindchange="onBankChange" disabled="{{busy}}"><view class="bank-picker">{{banks[bankIndex].name}} <text>⌄</text></view></picker><button class="bank-create" bindtap="onCreateBank" disabled="{{busy}}">＋ 新建本地题库</button></view>
 <view class="tabs"><button class="{{tab==='edit'?'active':''}}" data-tab="edit" bindtap="onTab">录题</button><button class="{{tab==='records'?'active':''}}" data-tab="records" bindtap="onTab">待上传 {{pendingCount}}</button><button class="{{tab==='uploads'?'active':''}}" data-tab="uploads" bindtap="onTab">云端与授权</button></view>
 <view wx:if="{{!ready}}" class="empty">读取本地记录…</view>
 <view wx:elif="{{tab==='edit'}}" class="editor">
  <view class="tools"><button bindtap="onCopyPrompt">复制提示词</button><button class="accent-soft" bindtap="onPaste" disabled="{{locked || busy}}">粘贴题目</button></view>
  <view wx:if="{{sourceIssues.length}}" class="issue"><view wx:for="{{sourceIssues}}" wx:key="index">{{item.message}}</view><button size="mini" bindtap="onCopyRaw">复制保留的原文</button><button wx:if="{{reply}}" size="mini" bindtap="onAcknowledge">已核对原文，以编辑内容为准</button></view>
  <view wx:if="{{reply}}">
   <view class="question-meta"><picker range="{{types}}" value="{{typeIndex}}" bindchange="onType" disabled="{{locked || busy}}"><view class="type-picker">{{types[typeIndex]}} ⌄</view></picker><button wx:if="{{canUndoType}}" size="mini" bindtap="onUndoType">撤销题型切换</button></view>
   <view class="muted time">首次录入 {{recordedAt}}</view>
   <view class="label">题目</view><textarea placeholder-class="theme-placeholder" value="{{reply.stem}}" data-field="stem" bindinput="onField" bindblur="onBlur" auto-height maxlength="-1" disabled="{{locked || busy}}" placeholder="输入题目原文" adjust-position="{{true}}" cursor-spacing="100"/>
   <view class="label">{{reply.type==='true_false'?'判断答案':'选项与答案'}}</view><view class="muted">点击圆点选中，再次点击取消</view>
   <view wx:for="{{editOptions}}" wx:key="key" class="option {{item.correct?'selected':''}}">
    <button size="mini" class="dot" data-key="{{item.key}}" bindtap="onAnswer" disabled="{{locked || busy}}" aria-label="{{item.key}} {{item.correct?'已选为答案':'未选'}}"><view class="answer-indicator"/></button>
    <text class="option-key">{{item.key}}</text>
    <view class="option-body"><textarea placeholder-class="theme-placeholder" value="{{item.content}}" data-field="option" data-index="{{index}}" bindinput="onField" bindblur="onBlur" auto-height maxlength="-1" disabled="{{locked || busy}}" placeholder="选项内容" cursor-spacing="100" aria-label="选项 {{item.key}}"/></view>
    <button size="mini" class="option-menu" data-index="{{index}}" bindtap="onOptionMenu" disabled="{{locked || busy}}" aria-label="{{item.key}} 选项操作">•••</button>
   </view>
   <view wx:if="{{reply.type==='true_false'}}" class="judgment"><button class="{{boolSelected && reply.answer===true?'selected':''}}" data-value="true" bindtap="onBool" disabled="{{locked || busy}}">{{boolSelected && reply.answer===true?'●':'○'}} 正确</button><button class="{{boolSelected && reply.answer===false?'selected':''}}" data-value="false" bindtap="onBool" disabled="{{locked || busy}}">{{boolSelected && reply.answer===false?'●':'○'}} 错误</button></view>
   <button wx:else class="add-option" bindtap="onAddOption" disabled="{{locked || busy || editOptions.length>=8}}">＋ 添加选项</button>
   <view class="label">解析</view><textarea placeholder-class="theme-placeholder" value="{{reply.explanation}}" data-field="explanation" bindinput="onField" bindblur="onBlur" auto-height maxlength="-1" disabled="{{locked || busy}}" placeholder="补充答案依据" cursor-spacing="100"/>
   <button class="disclosure" bindtap="onMore">更多信息 · 模型、章节、标签 {{more?'⌃':'⌄'}}</button><view wx:if="{{more}}" class="metadata">
    <view class="label">模型名称 / 版本</view><input placeholder-class="theme-placeholder" value="{{reply.model.name}}" data-field="name" bindinput="onField" bindblur="onBlur" disabled="{{locked || busy}}"/><input placeholder-class="theme-placeholder" value="{{reply.model.version}}" data-field="version" bindinput="onField" bindblur="onBlur" disabled="{{locked || busy}}"/>
    <picker range="{{versionSources}}" value="{{sourceIndex}}" bindchange="onVersionSource" disabled="{{locked || busy}}"><view class="bank-picker">版本来源：{{versionSources[sourceIndex]}}</view></picker>
    <textarea placeholder-class="theme-placeholder" value="{{warningsText}}" data-field="warnings" bindinput="onField" auto-height maxlength="-1" placeholder="内容提示，每行一项" disabled="{{locked || busy}}"/>
    <input placeholder-class="theme-placeholder" placeholder="章节" value="{{metadata.chapter}}" data-field="chapter" bindinput="onMetadata" bindblur="onBlur" disabled="{{locked || busy}}"/><input placeholder-class="theme-placeholder" placeholder="标签，用 | 分隔" value="{{tagsText}}" data-field="tags" bindinput="onMetadata" bindblur="onBlur" disabled="{{locked || busy}}"/>
    <picker range="{{difficulties}}" value="{{difficultyIndex}}" bindchange="onDifficulty" disabled="{{locked || busy}}"><view class="bank-picker">难度：{{difficulties[difficultyIndex]}}</view></picker>
    <input placeholder-class="theme-placeholder" placeholder="适用版本" value="{{metadata.applicable_version}}" data-field="applicable_version" bindinput="onMetadata" bindblur="onBlur" disabled="{{locked || busy}}"/><input placeholder-class="theme-placeholder" placeholder="外部编号" value="{{metadata.external_id}}" data-field="external_id" bindinput="onMetadata" bindblur="onBlur" disabled="{{locked || busy}}"/>
   </view><view wx:if="{{issues.length && !locked}}" class="issue"><view wx:for="{{issues}}" wx:key="index">{{item.message}}</view></view>
  </view>
  <view wx:else class="empty"><view class="empty-icon">＋</view><view>从一道题开始</view><view class="muted">粘贴后直接核对并编辑整道题</view><button bindtap="onManual" disabled="{{busy}}">手工录题</button></view>
 </view>
 <view wx:elif="{{tab==='records'}}" class="records"><input placeholder-class="theme-placeholder" placeholder="搜索待上传题目" value="{{query}}" bindinput="onSearch"/><view wx:for="{{visibleRecords}}" wx:key="id" class="record"><view data-id="{{item.id}}" bindtap="onEdit"><view class="record-title">{{item.stem}}</view><view class="muted {{item.invalid?'warning':''}}">{{item.status}} · {{item.recordedAt}}</view><view wx:if="{{item.invalid}}" class="warning">{{item.issue}}</view></view><view class="record-actions"><button size="mini" data-id="{{item.id}}" bindtap="onEdit" disabled="{{busy}}">{{item.editable?'修改':'查看'}}</button><button wx:if="{{item.editable}}" class="record-delete" size="mini" data-id="{{item.id}}" bindtap="onRemove" disabled="{{busy}}">删除</button></view></view><view wx:if="{{!records.length}}" class="empty">当前没有待上传题目</view>
  <button class="disclosure" bindtap="onTools">JSON 导入与导出 {{tools?'⌃':'⌄'}}</button><view wx:if="{{tools}}" class="file-tools"><button bindtap="onExport">导出并打开聊天发送</button><button bindtap="onImport">从聊天导入 JSON</button></view>
 </view>
 <view wx:else class="uploads"><view class="muted">每次点击上传只发送一个压缩包，重试使用原包。成功批次会从待上传列表清除。</view><view wx:for="{{jobs}}" wx:key="id" class="record"><view><view class="record-title">{{item.label}}</view><view class="muted">{{item.time}}</view><view class="warning">{{item.error}}</view><view wx:if="{{item.syncError}}" class="warning">已上传，下载尚未完成：{{item.syncError}}<button bindtap="onSync" disabled="{{busy}}">重试下载</button></view></view></view><view wx:if="{{!jobs.length}}" class="empty">当前没有待处理的云端任务</view><button wx:if="{{jobs.length}}" bindtap="onRetry" disabled="{{busy}}">恢复待处理任务</button><view class="maintainer-apply">
  <view class="label">题库维护者</view>
  <view class="muted">使用手机号和密码登录；手机号用于唯一登记。桌面管理员核实后授予题库上传权限。</view>
  <view wx:if="{{loggedIn}}" class="account-panel">
   <view class="account-name">手机号 {{maintainerPhoneDisplay}}</view>
   <view class="muted">登录方式：手机号和密码 · 状态：{{maintainerAccountStatus==='approved'?'已授权':maintainerAccountStatus==='rejected'?'申请被拒绝':maintainerAccountStatus==='revoked'?'权限已撤销':'等待管理员审核'}}</view>
   <view class="muted">Word 导出权限：{{hasExportPermission?'已授权':pendingExportPermission?'等待审批':'未授权'}}</view>
   <button class="secondary-button" bindtap="onRequestCurrentBank" loading="{{applying}}" disabled="{{busy || applying}}">申请维护当前题库</button>
   <button wx:if="{{!hasExportPermission && !pendingExportPermission}}" class="secondary-button" bindtap="onRequestExportPermission" loading="{{applying}}" disabled="{{busy || applying}}">申请 Word 导出权限</button>
   <button class="secondary-button" bindtap="onLogout" disabled="{{busy || applying}}">退出登录</button>
  </view>
  <view wx:else>
   <view class="auth-mode"><button class="{{authMode==='login'||authMode==='reset'?'active':''}}" data-mode="login" bindtap="onAuthMode" disabled="{{busy || applying}}">登录</button><button class="{{authMode==='register'?'active':''}}" data-mode="register" bindtap="onAuthMode" disabled="{{busy || applying}}">注册</button></view>
   <view class="label identity-label">手机号</view>
   <input type="number" maxlength="11" placeholder-class="theme-placeholder" value="{{maintainerPhone}}" bindinput="onMaintainerPhone" placeholder="中国大陆 11 位手机号" disabled="{{busy || applying}}"/>
   <block wx:if="{{authMode==='reset'}}">
    <view class="muted auth-note">需联系管理员重新设置维护者状态并获取一次性重置码。</view>
    <view class="label identity-label">管理员提供的重置码</view>
    <input maxlength="128" placeholder-class="theme-placeholder" value="{{maintainerResetToken}}" bindinput="onMaintainerResetToken" placeholder="输入一次性重置码" disabled="{{busy || applying}}"/>
    <view class="label identity-label">新密码</view>
    <input password placeholder-class="theme-placeholder" value="{{maintainerPassword}}" bindinput="onMaintainerPassword" placeholder="8–128 个字符，含大小写字母和数字" disabled="{{busy || applying}}"/>
    <view wx:for="{{maintainerPasswordRules}}" wx:key="key" class="password-check {{item.valid?'valid':'invalid'}}">{{item.valid?'✓':'○'}} {{item.label}}</view>
    <view class="label identity-label">确认新密码</view>
    <input password placeholder-class="theme-placeholder" value="{{maintainerPasswordConfirm}}" bindinput="onMaintainerPasswordConfirm" placeholder="再次输入新密码" disabled="{{busy || applying}}"/>
    <view wx:if="{{maintainerPasswordConfirm && !maintainerPasswordsMatch}}" class="warning">两次输入的密码不一致。</view>
    <button bindtap="onResetMaintainerPassword" loading="{{applying}}" disabled="{{busy || applying || !maintainerPasswordValid || !maintainerPasswordsMatch}}">{{applying?'正在重置…':'重置密码'}}</button>
    <button class="secondary-button" bindtap="onAuthMode" data-mode="login" disabled="{{busy || applying}}">返回登录</button>
   </block>
   <block wx:elif="{{authMode==='register'}}">
    <view class="label identity-label">真实姓名（必填）</view>
    <input maxlength="40" placeholder-class="theme-placeholder" value="{{maintainerRealName}}" bindinput="onMaintainerRealName" placeholder="填写真实姓名" disabled="{{busy || applying}}"/>
    <view class="label identity-label">昵称（必填，用于记录上传者）</view>
    <input maxlength="80" placeholder-class="theme-placeholder" value="{{maintainerNickname}}" bindinput="onMaintainerNickname" placeholder="题目上传后会在版本记录中显示此昵称" disabled="{{busy || applying}}"/>
    <view class="label identity-label">身份说明（必填）</view>
    <textarea class="identity-input" placeholder-class="theme-placeholder" value="{{maintainerIdentity}}" bindinput="onMaintainerIdentity" maxlength="500" auto-height="{{true}}" placeholder="班级/单位或与题库的关系，方便管理员核实" disabled="{{busy || applying}}"/>
    <view class="muted identity-count">{{maintainerIdentity.length}} / 500</view>
    <view class="permission-section-title">申请维护的题库</view>
    <view class="permission-section-hint">可多选；提交后由桌面管理员核实并授权。</view>
    <view wx:if="{{maintainerBanksLoading}}" class="muted">正在读取可申请的云端题库…</view>
    <view wx:elif="{{maintainerBanksError}}" class="issue">{{maintainerBanksError}}<button size="mini" bindtap="onRefreshMaintainerBanks" disabled="{{busy || applying || maintainerBanksLoading}}">重新获取</button></view>
    <checkbox-group wx:elif="{{maintainerBanks.length}}" class="maintainer-bank-list" bindchange="onMaintainerBanksChange">
     <label wx:for="{{maintainerBanks}}" wx:key="bank_id" class="maintainer-bank-option {{item.checked?'checked':''}}"><checkbox value="{{item.bank_id}}" checked="{{item.checked}}" disabled="{{busy || applying}}"/><view class="maintainer-bank-copy"><text class="maintainer-bank-name">{{item.name}}</text><text class="maintainer-bank-hint">题库维护权限</text></view><text class="maintainer-bank-check">{{item.checked?'已选择':'选择'}}</text></label>
    </checkbox-group>
    <view class="permission-section-title permission-section-title-export">其他权限</view>
    <view class="permission-section-hint">需要把题库整理成 Word 时再申请即可。</view>
    <checkbox-group class="permission-list" bindchange="onToggleExportPermission"><label class="permission-option {{applyExportPermission?'checked':''}}"><view class="permission-icon">W</view><view class="permission-copy"><text class="permission-title">Word 导出权限</text><text class="permission-subtitle">导出题库为可编辑的 Word 文档</text></view><checkbox value="export" checked="{{applyExportPermission}}" disabled="{{busy || applying}}"/><text class="permission-badge">{{applyExportPermission?'已选择':'申请'}}</text></label></checkbox-group>
    <view class="label identity-label">密码</view>
    <input password placeholder-class="theme-placeholder" value="{{maintainerPassword}}" bindinput="onMaintainerPassword" placeholder="8–128 个字符，含大小写字母和数字" disabled="{{busy || applying}}"/>
    <view wx:for="{{maintainerPasswordRules}}" wx:key="key" class="password-check {{item.valid?'valid':'invalid'}}">{{item.valid?'✓':'○'}} {{item.label}}</view>
    <view class="label identity-label">确认密码</view>
    <input password placeholder-class="theme-placeholder" value="{{maintainerPasswordConfirm}}" bindinput="onMaintainerPasswordConfirm" placeholder="再次输入密码" disabled="{{busy || applying}}"/>
    <view wx:if="{{maintainerPasswordConfirm}}" class="password-check {{maintainerPasswordsMatch?'valid':'invalid'}}">{{maintainerPasswordsMatch?'✓':'○'}} {{maintainerPasswordsMatch?'密码一致':'两次密码不一致'}}</view>
    <view class="muted auth-note">注册信息和登录方式与桌面版一致。上传权限需由桌面管理员审批。</view>
    <button bindtap="onRegisterMaintainer" loading="{{applying}}" disabled="{{busy || applying || !maintainerNickname || maintainerBanksLoading || (!maintainerBankIds.length && !applyExportPermission) || !maintainerPasswordValid || !maintainerPasswordsMatch}}">{{applying?'正在提交…':'注册并提交维护申请'}}</button>
   </block>
   <block wx:else>
    <view class="label identity-label">密码</view>
    <input password placeholder-class="theme-placeholder" value="{{maintainerPassword}}" bindinput="onMaintainerPassword" placeholder="输入密码" disabled="{{busy || applying}}"/>
    <button bindtap="onLoginMaintainer" loading="{{applying}}" disabled="{{busy || applying || !maintainerPhone || !maintainerPassword}}">{{applying?'正在登录…':'手机号和密码登录'}}</button>
    <button class="forgot-button" bindtap="onForgotMaintainerPassword" disabled="{{busy || applying}}">忘记密码？</button>
   </block>
  </view>
  <view wx:if="{{applicationMessage}}" class="{{applicationError?'issue':'notice'}}" role="alert">{{applicationMessage}}</view>
 </view></view>
 <view wx:if="{{error}}" class="issue" role="alert">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
 <view class="footer"><view class="save-status" bindtap="onBlur">{{saved}}</view><view class="footer-actions"><button bindtap="onNext" disabled="{{busy || !ready}}">下一题</button><button type="primary" bindtap="onUpload" disabled="{{busy || !ready || !pendingCount}}">{{busy?'处理中…':'上传 '+pendingCount+' 题'}}</button></view></view>
</view>
