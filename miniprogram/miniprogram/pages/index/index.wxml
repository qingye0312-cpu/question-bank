<view class="screen">
  <view class="header">
    <view class="eyebrow">本地题库 · 文字搜题</view>
    <view class="title">{{bankName}}</view>
    <view class="bank-meta muted">{{ready ? total + ' 道题 · 内置版本 ' + version + ' · 无需下载' : '正在读取内置内容'}}</view>
    <view class="search-box">
      <text class="search-symbol">⌕</text>
      <input class="search-input" placeholder="输入关键词或粘贴题目" value="{{query}}" disabled="{{!ready}}" maxlength="-1" bindinput="onInput" confirm-type="search" />
      <button wx:if="{{query}}" class="clear" bindtap="onClear" aria-label="清空搜索">×</button>
    </view>
    <view class="hint muted">空格分隔多个词，双引号搜索连续短语</view>
  </view>
  <view class="result-heading">
    <text>{{loading ? '正在查找…' : query ? '找到 ' + count + ' 道题' : '全部题目 · ' + count}}</text>
    <text class="muted">点击查看完整答案</text>
  </view>
  <scroll-view class="results" scroll-y scroll-top="{{scrollTop}}" bindscroll="onScroll" scroll-with-animation="{{false}}">
    <view wx:if="{{error}}" class="state">
      <view class="error">{{error}}</view>
      <button wx:if="{{!ready}}" class="primary retry" bindtap="initialize">重新加载</button>
    </view>
    <view wx:elif="{{loading}}" class="state muted">正在读取本地题库…</view>
    <view wx:elif="{{count === 0}}" class="state">
      <view>没有找到匹配的题目</view>
      <view class="muted">试试题干中的短词，或减少关键词</view>
    </view>
    <block wx:else>
      <view style="height: {{before}}px"></view>
      <view wx:for="{{rows}}" wx:key="questionId" class="result-row" data-id="{{item.id}}" bindtap="onOpen">
        <view class="card" role="button" aria-label="查看题目 {{item.number}}">
          <view class="row-meta"><text class="type">{{item.kind}}</text><text class="muted">{{item.number}}</text></view>
          <view class="snippet"><text wx:for="{{item.segments}}" wx:for-item="part" wx:for-index="partIndex" wx:key="partIndex" class="{{part.color >= 0 ? 'match-' + part.color : ''}}">{{part.text}}</text></view>
          <view class="answer-line"><text class="muted">答案</text><text class="answer">{{item.answer}}</text><text class="chevron">›</text></view>
        </view>
      </view>
      <view style="height: {{after}}px"></view>
      <view class="end muted">已显示全部 {{count}} 道题</view>
    </block>
  </scroll-view>
</view>
