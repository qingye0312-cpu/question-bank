page { height: 100%; overflow: hidden; }
.screen { height: 100vh; display: flex; flex-direction: column; }
.header { flex: none; padding: 28rpx 32rpx 20rpx; transition: padding 220ms ease; }
.header-fold { display: grid; grid-template-rows: 1fr; opacity: 1; transition: grid-template-rows 220ms ease, opacity 160ms ease; }
.header-fold-inner { min-height: 0; overflow: hidden; }
.bank-summary { padding-bottom: 28rpx; }
.header.is-collapsed { padding-top: 16rpx; padding-bottom: 16rpx; }
.is-collapsed .header-fold { grid-template-rows: 0fr; opacity: 0; pointer-events: none; }
.eyebrow { font-size: 22rpx; color: #377958; letter-spacing: 2rpx; }
.title { font-size: 40rpx; font-weight: 650; margin-top: 12rpx; }
.bank-meta { font-size: 23rpx; margin-top: 10rpx; }
.search-box { display: flex; align-items: center; background: white; border: 2rpx solid #c8d8cd; border-radius: 20rpx; padding: 0 18rpx; height: 96rpx; transition: height 220ms ease; }
.search-symbol { font-size: 48rpx; color: #377958; margin-right: 16rpx; }
.search-input { flex: 1; min-width: 0; font-size: 29rpx; height: 100%; }
.is-collapsed .search-box { height: 88rpx; }
/* Override the native button's default width and flex sizing. */
.search-box .clear { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: transparent; color: #708078; line-height: 1; font-size: 40rpx; }
.search-box .header-toggle { flex: 0 0 102rpx; width: 102rpx; min-width: 102rpx; height: 100%; margin: 0 0 0 12rpx; padding: 0 0 0 16rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; background: transparent; color: #377958; font-size: 23rpx; line-height: 1; white-space: nowrap; border-radius: 0; }
.header-toggle-arrow { flex: none; width: 12rpx; height: 12rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: translateY(3rpx) rotate(-45deg); transition: transform 220ms ease; }
.is-collapsed .header-toggle-arrow { transform: translateY(-3rpx) rotate(135deg); }
.search-box .header-toggle-hover { opacity: .65; }
.hint { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; font-size: 22rpx; margin-top: 14rpx; }
.hint .advanced-toggle { flex: none; width: auto; min-width: 0; margin: 0; padding: 0 4rpx; background: transparent; color: #377958; font-size: 22rpx; font-weight: 600; line-height: 1.5; border-radius: 4rpx; }
.hint .advanced-toggle-hover { opacity: .65; }
.result-heading { display: flex; justify-content: space-between; gap: 16rpx; padding-top: 36rpx; font-size: 23rpx; }
.results { height: 0; flex: 1; min-height: 0; }
.result-row { padding: 0 24rpx 16rpx; }
.card { border: 1rpx solid #e0e7e1; border-radius: 18rpx; background: white; padding: 22rpx 24rpx; }
.row-meta { display: flex; align-items: center; font-size: 22rpx; margin-bottom: 14rpx; }
.type { background: #edf4ef; color: #397051; border-radius: 6rpx; padding: 3rpx 10rpx; margin-right: 14rpx; }
.snippet { font-size: 29rpx; line-height: 1.7; word-break: break-all; overflow-wrap: anywhere; }
.answer-line { display: flex; align-items: center; margin-top: 18rpx; font-size: 24rpx; }
.answer { color: #246b4b; font-size: 29rpx; font-weight: 600; margin-left: 18rpx; }
.chevron { margin-left: auto; color: #8b9e90; font-size: 36rpx; }
.state { padding: 90rpx 40rpx; text-align: center; line-height: 2; }
.state .muted { font-size: 25rpx; margin-top: 16rpx; }
.retry { margin-top: 28rpx; }
.end { text-align: center; font-size: 22rpx; padding: 24rpx 0 60rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
@media (prefers-reduced-motion: reduce) {
  .header, .header-fold, .search-box, .header-toggle-arrow { transition: none; }
}

.app-version{float:right;font-size:21rpx;letter-spacing:0;color:#708078}.bank-switch-hint{font-size:23rpx;font-weight:400;color:#377958}.model-tools{display:flex;gap:12rpx;margin-top:18rpx}.model-tools button{flex:1;margin:0;padding:14rpx 10rpx;font-size:22rpx;line-height:1.5;color:#285a42;background:#e7eeea;border-radius:12rpx}.model-tools button:first-child{flex:1.65}
