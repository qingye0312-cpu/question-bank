page{height:100%;background:var(--page);color:var(--ink);font-size:30rpx}
.share-page{box-sizing:border-box;min-height:100vh;padding:44rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}
.share-heading{margin-bottom:34rpx}
.title{font-size:42rpx;font-weight:650}
.muted{color:var(--muted);font-size:25rpx;line-height:1.65;margin-top:12rpx}
.share-card{background:var(--surface);border:2rpx solid var(--border);border-radius:22rpx;padding:30rpx;margin-bottom:24rpx}
.card-title{font-size:31rpx;font-weight:650}
button{box-sizing:border-box;width:100%;margin:22rpx 0 0;padding:20rpx 24rpx;border:2rpx solid var(--border);border-radius:15rpx;background:var(--surface);color:var(--accent);font-size:27rpx;line-height:1.5;text-align:center}
button::after{border:0}
button[disabled]{opacity:.45}
button.primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
button.mode-toggle{display:flex;justify-content:space-between;text-align:left;background:var(--tint);border-color:transparent}
.json-actions{padding-top:6rpx}
.json-actions .note{padding:10rpx 4rpx 0}
button.accent-soft{background:var(--selected);border-color:var(--selected)}
.message{font-size:25rpx;line-height:1.6;margin-top:22rpx;padding:18rpx;border-radius:14rpx}
.error{color:var(--danger);background:var(--danger-bg)}
.notice{color:var(--accent);background:var(--tint)}
