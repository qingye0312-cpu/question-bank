{
  "name": "question-bank",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/sync-client-assets.mjs && node scripts/prepare-ocr.mjs && vite --host 127.0.0.1",
    "build": "node scripts/sync-client-assets.mjs && node scripts/prepare-ocr.mjs && tsc --noEmit && vite build",
    "tauri": "node scripts/tauri.mjs",
    "build:windows:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/scripts/build-portable.ps1",
    "test:platforms": "node --test tests/platform-build.test.mjs",
    "test:ui": "node --test tests/search-presentation.test.mjs tests/ocr-client.test.mjs tests/appearance.test.mjs",
    "prepare:miniprogram": "node scripts/sync-client-assets.mjs && node scripts/build-miniprogram-vendor.mjs && node tools/mobile-index/build.mjs",
    "serve:miniprogram": "node tools/mobile-index/server.mjs",
    "check:miniprogram": "node scripts/sync-client-assets.mjs --check && node scripts/build-miniprogram-vendor.mjs --check && node tools/mobile-index/build.mjs --check && tsc --noEmit -p miniprogram/tsconfig.json",
    "test:miniprogram": "node --test tests/miniprogram.test.mjs tests/miniprogram-cloud.test.mjs",
    "feishu:prepare": "node tools/feishu/setup.mjs init",
    "feishu:check": "node tools/feishu/setup.mjs doctor",
    "feishu:plan": "node tools/feishu/setup.mjs plan",
    "feishu:setup": "node tools/feishu/setup.mjs apply",
    "test:feishu": "node --test tests/feishu-setup.test.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "test:intake": "node scripts/sync-client-assets.mjs --check && node --test tests/intake.test.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "test:cloud": "node --test tests/cloud-auth.test.mjs tests/cloud-workflow.test.mjs",
    "cloud:doctor": "node tools/cloud/ops.mjs doctor",
    "cloud:verify": "node tools/cloud/ops.mjs verify",
    "cloud:deploy": "node scripts/build-cloud.mjs && node tools/cloud/ops.mjs deploy"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^0.468.0",
    "react": "^19",
    "react-dom": "^19",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "fflate": "0.8.3",
    "typescript": "^5.9",
    "vite": "^7"
  }
}
