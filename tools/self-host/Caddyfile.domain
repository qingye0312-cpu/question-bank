# Install only after the public domain certificate and key are in place.
# Import this file from /etc/caddy/Caddyfile alongside the existing IP site.
# Public :8013 -> FRP -> sslh :8444 -> this Caddy listener :8443.
https://qbank.creart.top:8443 {
	bind 127.0.0.1
	tls /etc/caddy/certs/qbank.creart.top/fullchain.pem /etc/caddy/certs/qbank.creart.top/key.pem
	reverse_proxy 127.0.0.1:8080
}
