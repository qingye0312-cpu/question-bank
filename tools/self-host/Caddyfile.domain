# Install only after the public domain certificate and key are in place.
# Import this file from /etc/caddy/Caddyfile alongside the existing IP site.
# Public :8013 -> FRP -> sslh :8444 -> this Caddy listener :8443.
https://qbank.creart.top:8443 {
	bind 127.0.0.1
	tls /etc/caddy/certs/qbank.creart.top/current/fullchain.pem /etc/caddy/certs/qbank.creart.top/current/key.pem
	handle /download* {
		root * /var/lib/qbank-desktop-updates/site
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /v1/desktop/releases/* {
		root * /var/lib/qbank-desktop-updates/releases
		file_server
	}
	handle_path /v1/desktop/* {
		root * /var/lib/qbank-desktop-updates
		@latest path /latest.json
		header @latest Cache-Control "no-store"
		file_server
	}
	reverse_proxy 127.0.0.1:8080
}
