# Public :8013 -> FRP -> sslh :8444 -> this Caddy listener :8443.
(qbank-routes) {
	handle /download* {
		root * /var/lib/qbank-desktop-updates/site
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	handle /fishdownload* {
		root * /var/lib/qbank-desktop-updates/site
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	handle /fastdowmload/api* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /fastdowmload* {
		root * /var/lib/qbank-fastdownload/site
		@fastdownloadIndex path /fastdowmload /fastdowmload/
		rewrite @fastdownloadIndex /fastdowmload/index.html
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /v1/desktop/releases/* {
		root * /var/lib/qbank-desktop-updates/releases
		file_server
	}
	handle_path /v1/desktop/* {
		root * /var/lib/qbank-desktop-updates
		@latest path /latest.json
		header @latest Cache-Control "no-store"
		file_server
	}
	reverse_proxy 127.0.0.1:8080
}

https://qbank.acharrystar.top:8443 {
	bind 127.0.0.1
	tls /etc/caddy/certs/qbank.acharrystar.top/current/fullchain.pem /etc/caddy/certs/qbank.acharrystar.top/current/key.pem
	import qbank-routes
}
