# 本机配置复制到项目根目录 .env.feishu.local；该文件受 .gitignore 保护。
# App Secret 只在本机／服务端填写，不发到聊天、不放进小程序。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格网页地址中 /base/ 后的标识，不是 App ID 或访问令牌。
# 此工具不接受知识库 /wiki/ 节点标识；请先取得真实的 Bitable app_token。
FEISHU_BASE_APP_TOKEN=

# 空白时按标准表名查找，缺失则由建表命令创建。
# 如指定 ID，必须属于上面的多维表格且名称符合 schema.mjs。
FEISHU_CANDIDATES_TABLE_ID=
FEISHU_BANKS_TABLE_ID=
FEISHU_RELEASES_TABLE_ID=
