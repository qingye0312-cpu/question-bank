{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "cos:GetBucketVersioning"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1324463245:qbank-release-1324463245/*"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "cos:GetBucket"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1324463245:qbank-release-1324463245/*"
      ],
      "condition": {
        "string_like": {
          "cos:prefix": "states%2F*"
        }
      }
    },
    {
      "effect": "allow",
      "action": [
        "cos:GetObject"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1324463245:qbank-release-1324463245/states/*"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "cos:PutObject"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1324463245:qbank-release-1324463245/states/*"
      ],
      "condition": {
        "string_equal": {
          "cos:x-cos-forbid-overwrite": "true"
        }
      }
    }
  ]
}
