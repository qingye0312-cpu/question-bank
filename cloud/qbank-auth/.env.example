# 仅 WX_APP_ID 可以出现在客户端。所有实际配置只填写在腾讯云函数环境变量中。
WX_APP_ID=wx22c8135ae81d3acc
WX_APP_SECRET=
# 32 字节随机值的 64 位十六进制表示；轮换此值或递增 AUTH_VERSION 可使旧会话失效。
QBANK_SESSION_SECRET=
QBANK_AUTH_VERSION=1
QBANK_BANKS=[{"bank_id":"ad50971f-66af-51c2-bb0e-dc798b03b369","name":"HarmonyOS 初级认证"}]
# 首次微信登录返回本人 openid 后，由维护者在此授权；空名单拒绝所有上传者。
QBANK_DEVELOPERS={}
COS_REGION=ap-guangzhou
COS_INBOX_BUCKET=qbank-inbox-1324463245
# 收集桶必须未开启过版本控制，才能使用 COS 禁止覆盖的原子写入。
# 完成配置、验证允许/拒绝路径后再改为 true。
QBANK_UPLOAD_ENABLED=false
# 微信原生请求不需要浏览器 CORS；桌面接入时按实际 Origin 配置，禁止 *。
QBANK_ALLOWED_ORIGINS=[]

# 发布与匿名同步默认为关闭，部署新包并验证发布桶策略后才开启。
# 发布桶同样必须从未启用版本控制；旧 qbank-release 桶已开启，不能继续使用。
COS_RELEASE_BUCKET=qbank-release-v2-1324463245
QBANK_SYNC_ENABLED=false
# 每人独立密钥，仅保存 SHA-256 摘要和逐库权限。由 create-maintainer.mjs 生成条目。
QBANK_MAINTAINERS=[]
