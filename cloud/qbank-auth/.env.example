# Self-hosted service configuration. Keep this file outside the repository in production.
# 32 bytes in hexadecimal. Rotating this value invalidates existing sessions.
QBANK_SESSION_SECRET=
QBANK_AUTH_VERSION=1
QBANK_BANKS=[{"bank_id":"ad50971f-66af-51c2-bb0e-dc798b03b369","name":"HarmonyOS 初级认证"}]
QBANK_UPLOAD_ENABLED=false
QBANK_SYNC_ENABLED=true
QBANK_ALLOWED_ORIGINS=[]
# Each desktop maintainer entry contains a key digest and per-bank upload/merge grants;
# add real_name to show the person's name in revision history when desired.
QBANK_MAINTAINERS=[]
# Highest-privilege desktop maintainer ids allowed to create cloud-backed banks and manage phone maintainers.
QBANK_CLOUD_CREATORS=[]
QBANK_STORAGE_ROOT=/var/lib/qbank-auth
QBANK_BIND_HOST=127.0.0.1
QBANK_PORT=8080
