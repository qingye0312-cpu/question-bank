{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": ["cos:GetBucketVersioning"],
      "resource": ["qcs::cos:ap-guangzhou:uid/1324463245:qbank-inbox-1324463245/*"]
    },
    {
      "effect": "allow",
      "action": ["cos:GetObject"],
      "resource": ["qcs::cos:ap-guangzhou:uid/1324463245:qbank-inbox-1324463245/inbox/*"]
    },
    {
      "effect": "allow",
      "action": ["cos:PutObject"],
      "resource": ["qcs::cos:ap-guangzhou:uid/1324463245:qbank-inbox-1324463245/inbox/*"],
      "condition": {"string_equal": {"cos:x-cos-forbid-overwrite": "true"}}
    }
  ]
}
